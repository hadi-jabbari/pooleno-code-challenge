NODE_ENV=development
PORT=3000
APP_ROLE=all

# Host ports 5433/9094 avoid clashing with other local stacks on 5432/9092.
DATABASE_URL=postgresql://pooleno:pooleno@127.0.0.1:5433/pooleno

KAFKA_BROKERS=127.0.0.1:9094
KAFKA_CLIENT_ID=pooleno-order-service
KAFKA_GROUP_ID=pooleno-order-processors
KAFKA_TOPIC_ORDER_ACCEPTED=order.accepted
KAFKA_TOPIC_ORDER_DLQ=order.accepted.dlq

OUTBOX_POLL_INTERVAL_MS=1000
CONSUMER_MAX_RETRIES=3
CONSUMER_RETRY_BASE_MS=200
MOCK_EXTERNAL_API_FAILURE_RATE=0
